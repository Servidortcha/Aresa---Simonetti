NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu-clave-aqui
# Alternativa con el nombre clásico (supabase-js también la acepta):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-aqui

# Lectura automática de facturas y comprobantes con Google Gemini.
# La clave se usa SOLO en el servidor (API route), nunca se expone al navegador.
# Crear la clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu-clave-de-gemini-aqui
# Modelo opcional (por defecto gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
